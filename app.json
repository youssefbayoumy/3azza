{
  "expo": {
    "name": "3azza",
    "slug": "3azza",
    "version": "2.3.3",
    "orientation": "portrait",
    "icon": "./assets/chatgpt-image-aug-9-2026-app-icon.png",
    "backgroundColor": "#081421",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/android-icon-foreground.png",
      "resizeMode": "contain",
      "backgroundColor": "#081421"
    },
    "ios": {
      "supportsTablet": true,
      "backgroundColor": "#081421"
    },
    "android": {
      "backgroundColor": "#081421",
      "adaptiveIcon": {
        "backgroundColor": "#081421",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 12,
      "package": "com.youssefbayoumy.x3azza",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "androidStatusBar": {
      "barStyle": "light-content"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/with-https-url-queries",
      "expo-font",
      "expo-sqlite",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow 3azza to unlock the app with your device biometrics."
        }
      ],
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow 3azza to attach photos to your maintenance records and documents.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-system-ui",
      [
        "expo-navigation-bar",
        {
          "barStyle": "light",
          "enforceContrast": false
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "expo-navigation-bar": {
        "barStyle": "light",
        "enforceContrast": false
      },
      "eas": {
        "projectId": "a845f95b-c48a-454e-b10a-d01ea5b76a45"
      }
    },
    "owner": "youssefbayoumy"
  }
}
