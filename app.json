{
  "expo": {
    "name": "3azza",
    "slug": "3azza",
    "version": "2.3.4",
    "orientation": "default",
    "icon": "./assets/chatgpt-image-aug-9-2026-app-icon.png",
    "backgroundColor": "#081421",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "backgroundColor": "#081421"
    },
    "android": {
      "backgroundColor": "#081421",
      "icon": "./assets/chatgpt-image-aug9-icon-adaptive-balanced-v3.png",
      "adaptiveIcon": {
        "backgroundImage": "./assets/chatgpt-image-aug9-icon-adaptive-balanced-v3.png",
        "foregroundImage": "./assets/transparent-adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 15,
      "package": "com.youssefbayoumy.x3azza",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/with-https-url-queries",
      "./plugins/with-android-material-compatibility",
      "./plugins/with-android-launcher-alias",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#081421",
          "image": "./assets/scooter-logo-splash.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-font",
      "expo-sqlite",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow 3azza to unlock the app with your device biometrics."
        }
      ],
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow 3azza to attach photos to your maintenance records and documents.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-system-ui",
      [
        "expo-navigation-bar",
        {
          "style": "light",
          "enforceContrast": false
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-status-bar",
        {
          "style": "light"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a845f95b-c48a-454e-b10a-d01ea5b76a45"
      }
    },
    "owner": "youssefbayoumy"
  }
}
