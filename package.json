{
  "name": "3azza",
  "version": "2.3.3",
  "main": "index.ts",
  "scripts": {
    "catalog:generate": "node scripts/generate-scooter-catalog.mjs",
    "catalog:check": "node scripts/generate-scooter-catalog.mjs --check",
    "model-data:generate": "node scripts/generate-model-knowledge-base.mjs",
    "model-data:check": "node scripts/generate-model-knowledge-base.mjs --check",
    "maintenance:validate": "tsx scripts/validate-maintenance-profiles.ts",
    "maintenance:compare": "tsx scripts/compare-maintenance-profiles.ts",
    "generate": "npm run catalog:generate && npm run model-data:generate",
    "prestart": "npm run generate",
    "start": "expo start",
    "preandroid": "npm run generate",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "lint": "expo lint",
    "check": "npm run catalog:check && npm run model-data:check && npm run maintenance:validate && npm run typecheck && npm run lint && npm test",
    "doctor": "npx --yes expo-doctor@1.20.1",
    "security:android": "npm audit --omit=dev --audit-level=critical",
    "release:check": "npm run check && npm run doctor && npm run security:android"
  },
  "dependencies": {
    "@expo-google-fonts/manrope": "^0.4.2",
