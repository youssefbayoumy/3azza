    "@react-native-community/datetimepicker": "8.6.0",
    "@react-navigation/bottom-tabs": "^7.15.6",
    "@react-navigation/native": "^7.1.34",
    "@react-navigation/native-stack": "^7.14.6",
    "babel-preset-expo": "~55.0.8",
    "expo": "~55.0.28",
    "expo-blur": "~55.0.16",
    "expo-crypto": "~55.0.17",
    "expo-document-picker": "~55.0.15",
    "expo-file-system": "~55.0.24",
    "expo-font": "~55.0.8",
    "expo-image-picker": "~55.0.22",
    "expo-local-authentication": "~55.0.16",
    "expo-navigation-bar": "~55.0.15",
    "expo-network": "~55.0.16",
    "expo-notifications": "~55.0.25",
    "expo-secure-store": "~55.0.16",
    "expo-sharing": "~55.0.22",
    "expo-splash-screen": "~55.0.23",
    "expo-sqlite": "~55.0.18",
    "expo-status-bar": "~55.0.6",
    "expo-system-ui": "~55.0.20",
    "nativewind": "^4.2.3",
    "react": "19.2.0",
    "react-hook-form": "^7.72.0",
    "react-native": "0.83.10",
    "react-native-pager-view": "8.0.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-worklets": "0.7.4",
    "tailwindcss": "^3.4.19",
    "zustand": "^5.0.12"
